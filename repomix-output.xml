                        contextMenu.style.left = e.pageX + 'px';
                        contextMenu.style.top = e.pageY + 'px';
                    });
                }
                let rectcolor = ""
                svgelement.addEventListener('mouseover', function() {
                    getmarkersinglelines(parseInt(svgelement.getAttribute('fline'), 10))
